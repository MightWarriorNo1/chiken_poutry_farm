# Prosper EdgeBox configuration — copy to .env and fill in.
# All settings can also be supplied via /etc/prosper-edge/config.yaml.

# ── Device identity (issued by cloud provisioning) ──
EDGE_DEVICE_ID=edge-dev-001
EDGE_DEVICE_NAME=Dev Laptop
EDGE_AUTH_TOKEN=replace-with-jwt-from-cloud

# ── Cloud endpoints ──
EDGE_CLOUD_BASE_URL=http://localhost:8080
EDGE_CLOUD_INGEST_PATH=/v1/ingest
EDGE_CLOUD_CONFIG_PATH=/v1/edge/config

# ── Pipeline cadence ──
EDGE_FRAME_INTERVAL_SECONDS=2.0
EDGE_HEARTBEAT_INTERVAL_SECONDS=30
EDGE_CONFIG_POLL_INTERVAL_SECONDS=300
EDGE_SYNC_BATCH_SIZE=50
EDGE_SYNC_FLUSH_INTERVAL_SECONDS=5

# ── Storage ──
EDGE_OUTBOX_PATH=./outbox.db

# ── Static (offline) config — set to bypass cloud config polling. See example.config.yaml. ──
EDGE_STATIC_CONFIG_PATH=

# ── MQTT (sensors) ──
EDGE_MQTT_HOST=localhost
EDGE_MQTT_PORT=1883
EDGE_MQTT_TOPIC_PREFIX=prosper/sensors

# ── Telemetry ──
EDGE_LOG_LEVEL=INFO
EDGE_LOG_FORMAT=json
EDGE_OTEL_EXPORTER=console        # console | otlp
EDGE_OTEL_OTLP_ENDPOINT=
