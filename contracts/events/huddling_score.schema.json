{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prosper.example.com/schemas/huddling_score.schema.json",
  "title": "HuddlingScore",
  "description": "A huddling/clustering score derived from bird positions in a frame.",
  "type": "object",
  "required": [
    "event_id", "device_id", "camera_id", "captured_at", "processed_at",
    "model_version", "huddling_score"
  ],
  "properties": {
    "event_id":            { "type": "string", "format": "uuid" },
    "device_id":           { "type": "string" },
    "camera_id":           { "type": "string" },
    "shed_id":             { "type": "string" },
    "flock_id":            { "type": "string" },
    "zone_id":             { "type": "string" },
    "captured_at":         { "type": "string", "format": "date-time" },
    "processed_at":        { "type": "string", "format": "date-time" },
    "model_version":       { "type": "string" },
    "huddling_score":      { "type": "number",  "minimum": 0, "maximum": 1 },
    "cluster_count":       { "type": "integer", "minimum": 0 },
    "largest_cluster_pct": { "type": "number",  "minimum": 0, "maximum": 1 },
    "snapshot_uri":        { "type": "string",  "format": "uri" }
  },
  "additionalProperties": false
}
