{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prosper.example.com/schemas/bird_detection.schema.json",
  "title": "BirdDetection",
  "description": "A single bird-detection inference result emitted by an EdgeBox.",
  "type": "object",
  "required": [
    "event_id", "device_id", "camera_id", "captured_at", "processed_at",
    "model_version", "bird_count", "density_score", "confidence"
  ],
  "properties": {
    "event_id":      { "type": "string", "format": "uuid" },
    "device_id":     { "type": "string", "minLength": 1 },
    "camera_id":     { "type": "string", "minLength": 1 },
    "shed_id":       { "type": "string" },
    "flock_id":      { "type": "string" },
    "zone_id":       { "type": "string" },
    "captured_at":   { "type": "string", "format": "date-time" },
    "processed_at":  { "type": "string", "format": "date-time" },
    "model_version": { "type": "string", "examples": ["bird-detector@1.0.0"] },
    "bird_count":    { "type": "integer", "minimum": 0 },
    "density_score": { "type": "number",  "minimum": 0, "maximum": 1 },
    "confidence":    { "type": "number",  "minimum": 0, "maximum": 1 },
    "snapshot_uri":  { "type": "string",  "format": "uri" },
    "bbox_centroids": {
      "type": "array",
      "description": "Normalized [x, y] coordinates in [0, 1] for each detected bird.",
      "items": {
        "type": "array",
        "minItems": 2,
        "maxItems": 2,
        "items": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    }
  },
  "additionalProperties": false
}
