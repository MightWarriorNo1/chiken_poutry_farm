{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prosper.example.com/schemas/sensor_reading.schema.json",
  "title": "SensorReading",
  "description": "A single IoT sensor reading captured at the edge.",
  "type": "object",
  "required": ["event_id", "device_id", "sensor_id", "sensor_type", "value", "unit", "recorded_at"],
  "properties": {
    "event_id":   { "type": "string", "format": "uuid" },
    "device_id":  { "type": "string" },
    "sensor_id":  { "type": "string" },
    "sensor_type": {
      "type": "string",
      "enum": ["temperature", "humidity", "ammonia", "co2", "water_flow", "water_pressure"]
    },
    "shed_id":    { "type": "string" },
    "zone_id":    { "type": "string" },
    "value":      { "type": "number" },
    "unit":       { "type": "string" },
    "recorded_at": { "type": "string", "format": "date-time" },
    "quality": {
      "type": "string",
      "enum": ["good", "suspect", "bad"],
      "default": "good"
    }
  },
  "additionalProperties": false
}
